# Chocobot 2.0 — Variables de entorno
# Copia este archivo a .env y completa los valores.

# Identidad
OWNER_NUMBER=5491123456789
BOT_PREFIX=.

# Rutas
AUTH_DIR=./auth
DATA_DIR=./data
TEMP_DIR=./temp
LOGS_DIR=./logs

# Logs
LOG_LEVEL=info

# Modo
NODE_ENV=production

# APIs externas (opcional — déjalas vacías si no las usas)
POLLINATIONS_API_KEY=
PINTEREST_ACCESS_TOKEN=
OPENAI_API_KEY=
GIPHY_API_KEY=
